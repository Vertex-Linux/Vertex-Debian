#!/bin/sh
# Neutralize Debian's own branding without removing the desktop-base
# package itself — it turns out to be a hard Depends of task-desktop (the
# shared foundation task-gnome-desktop builds on), so purging it cascades
# into removing gnome-shell/gdm3/the whole desktop. Instead, strip out every
# asset it ships (wallpapers, GDM/shutdown-screen art, logos) and overwrite
# the specific paths other components read directly.
set -e

# Delete every image asset desktop-base ships, system-wide — wallpapers,
# GDM/login-screen backgrounds, shutdown-dialog art, splash themes, logos,
# all of it (dpkg won't mind files disappearing underneath it; this doesn't
# touch the package database, so task-gnome-desktop's dependency stays
# satisfied). We don't rely on any of it; specific paths other components
# read directly are recreated with Vertex's own art right after.
dpkg -L desktop-base 2>/dev/null \
    | grep -E '\.(png|svg|jpe?g|xpm|gif)$' \
    | xargs -r rm -f 2>/dev/null || true

# Recreate the specific paths known to be read directly elsewhere (GDM
# greeter's own background is handled separately via its dconf profile,
# below), now with Vertex's mark instead of Debian's.
mkdir -p /usr/share/pixmaps /usr/share/plymouth
for f in /usr/share/pixmaps/debian-logo.png /usr/share/pixmaps/debian-logo.bmp \
         /usr/share/plymouth/debian-logo.png; do
    rm -f "$f"
    cp /usr/share/pixmaps/vertex-logo.png "$f"
done

# The Settings "About" page's OS logo is the one exception LOGO= doesn't
# cover: Debian's gnome-control-center is built with -Ddistributor_logo and
# -Ddark_mode_distributor_logo both pointing at this exact path (confirmed
# from debian/rules upstream at salsa.debian.org/gnome-team/gnome-control-center),
# which gtk_picture_set_filename() loads directly, bypassing os-release
# entirely. Overwrite it in place with Vertex's mark (kept as an actual SVG
# since that's the format gnome-control-center expects here).
mkdir -p /usr/share/icons/vendor/scalable/emblems
# This path is Debian's update-alternatives-managed "vendor" icon theme —
# the alternative symlink itself is untouched, but its target was one of
# the files just deleted above, leaving it dangling. cp refuses to write
# through a dangling symlink, so drop it first and write a real file.
rm -f /usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg
cp /usr/share/vertex/vertex-mark.svg \
    /usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg

# Classic Debian "distributor-logo" alternative — some tools check this
# instead of (or in addition to) os-release's LOGO= key.
update-alternatives --install /usr/share/pixmaps/distributor-logo.png \
    distributor-logo /usr/share/pixmaps/vertex-logo.png 50 2>/dev/null || true

# calamares-settings-debian ships a generic "Install Debian" launcher
# alongside our own vertex-installer.desktop — drop every Calamares
# .desktop file except ours, whatever this one is actually named.
find /usr/share/applications -maxdepth 1 -iname 'calamares*.desktop' \
    ! -name 'vertex-installer.desktop' -delete 2>/dev/null || true

# calamares-settings-debian also ships an entire unused "debian" branding
# component alongside ours — settings.conf already points Calamares at
# "vertex" so this is inert, but no reason to ship it.
rm -rf /etc/calamares/branding/debian
