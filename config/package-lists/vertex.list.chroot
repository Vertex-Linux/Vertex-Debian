# Vertex Linux base package selection.
# Kept deliberately minimal: Debian + latest available GNOME + Flatpak +
# Fastfetch + Calamares + whatever update-vertex-apps.sh needs to fetch
# Vertex's own tools (VPKG, Vertex Updater, Vertex Driver Downloader) at
# build time.

# --- Base system / live infrastructure ---
live-boot
live-config
live-config-systemd
sudo
network-manager
firmware-misc-nonfree

# --- Bootloader (UEFI only for now — grub-pc and grub-efi-amd64 Conflict
# with each other in Debian, so BIOS support is a later iteration) ---
grub-efi-amd64

# --- Boot splash ---
plymouth
plymouth-themes

# --- GNOME desktop (full task metapackage = latest GNOME in this suite) ---
task-gnome-desktop
gnome-shell
gdm3

# --- Requested extras ---
flatpak
gnome-software-plugin-flatpak
fastfetch

# --- Needed by update-vertex-apps.sh (fetches VPKG / Vertex Updater /
# Vertex Driver Downloader from GitHub releases; python3 comes in via
# GNOME already, curl doesn't) ---
curl

# --- GNOME Shell extensions (pre-installed + enabled by default, see the
# dconf override in includes.chroot/etc/dconf/db/local.d/) ---
gnome-shell-extension-manager
gnome-shell-extension-dashtodock
gnome-shell-extension-blur-my-shell

# --- Installer ---
calamares
calamares-settings-debian
